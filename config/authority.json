{
  "schema_version": 1,
  "authority_chain": [
    "Founder Vicky Gautam",
    "Dr. Victor",
    "Tony Stark"
  ],
  "levels": {
    "L0": {
      "mode": "AUTO",
      "scope": [
        "read_repository_metadata",
        "validate_constitution",
        "parse_logs",
        "classify_incident",
        "generate_status_report"
      ]
    },
    "L1": {
      "mode": "AUTO",
